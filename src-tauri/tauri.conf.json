{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apphub",
  "mainBinaryName": "apphub",
  "version": "0.1.0",
  "identifier": "io.github.apphub",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Apphub", "width": 900, "height": 640, "minWidth": 560, "minHeight": 420 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis"],
    "shortDescription": "Your desktop apps in one window",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false, "installerIcon": "icons/icon.ico" }
    }
  }
}
